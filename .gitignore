routes.conf
routes-*.conf

# Tor keeps its directory cache, guard state and fetched bridges here.
# Large, machine-local and rebuilt on demand.
*-tor/

# Pluggable transport binaries put here by scripts/build-pt.sh. The image
# carries its own, built for the platform it ships to.
pt/

